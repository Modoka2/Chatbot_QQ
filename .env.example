# 复制为 .env 后填入真实值（.env 已加入 .gitignore，不会被提交）
# 大模型：DeepSeek 官网 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=

# 公众号后台 -> 设置与开发 -> 基本配置
WECHAT_MP_TOKEN=
WECHAT_MP_APPID=
WECHAT_MP_SECRET=

# OneBot（NapCat / LLOneBot）HTTP API 的 access token 与上报密钥，可留空
ONEBOT_ACCESS_TOKEN=
ONEBOT_SECRET=

# 可选：联网搜索用 Tavily（不填也能用内置的免 Key 搜索源）
TAVILY_API_KEY=
